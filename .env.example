# Local PoC only; use infra/scripts/init_env.py to generate random credentials.
POSTGRES_DB=drm_poc
POSTGRES_USER=drm_app
POSTGRES_PASSWORD=TBD-LOCAL-SECRET
DATABASE_URL=postgresql://drm_app:TBD-LOCAL-SECRET@postgres:5432/drm_poc
POSTGRES_RUNTIME_PASSWORD=TBD-LOCAL-SECRET
RUNTIME_DATABASE_URL=postgresql://edarms_api_login:TBD-LOCAL-SECRET@postgres:5432/drm_poc
KEYCLOAK_ADMIN=localadmin
KEYCLOAK_ADMIN_PASSWORD=TBD-LOCAL-SECRET
KEYCLOAK_REALM=drm-poc
OIDC_ISSUER=http://localhost:8080/realms/drm-poc
OIDC_JWKS_URL=http://keycloak:8080/realms/drm-poc/protocol/openid-connect/certs
OIDC_AUDIENCE=drm-api
OIDC_WEB_CLIENT_ID=drm-web
OIDC_ENFORCE=true
DRM_ENV=poc
AUDIT_ANCHOR_REQUIRED=false
MINIO_ROOT_USER=TBD-LOCAL-SECRET
MINIO_ROOT_PASSWORD=TBD-LOCAL-SECRET
